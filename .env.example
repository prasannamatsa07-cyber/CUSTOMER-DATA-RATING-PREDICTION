# Environment Variables — Template
# Copy this file to .env and fill in values if needed.
# This project does not require any API keys out of the box.

# ─── Optional: LLM / external API extension ────────────────────────
# OPENAI_API_KEY=your_openai_api_key_here
# HF_TOKEN=your_huggingface_token_here

# ─── Optional: Custom data path override ───────────────────────────
# DATA_PATH=data/dataset.csv

# ─── Optional: Streamlit runtime settings ──────────────────────────
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_HEADLESS=true
